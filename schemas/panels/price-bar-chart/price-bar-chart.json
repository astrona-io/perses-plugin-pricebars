{
  "kind": "PriceBarChart",
  "spec": {
    "categoryLabel": "start",
    "bands": [
      { "upTo": 75, "color": "#3274d9", "label": "very cheap" },
      { "upTo": 100, "color": "#2e9e4f", "label": "under average" },
